digraph G {
  rankdir=LR; fontname="Helvetica"; node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#f5f5f5"]; edge [fontsize=9];
  subgraph cluster_src { label="Fuentes"; style=dashed;
    rnt [label="Fuente primaria\nRNT CSV (datos.gov.co)", fillcolor="#dbe9ff"];
    api [label="API programatica\nSocrata SODA (datos.gov.co)\npaginacion + timeout", fillcolor="#dbe9ff"]; }
  subgraph cluster_af { label="Apache Airflow 3.1.8 (DAG: dependencias, retries, logs, monitoreo)"; style=filled; fillcolor="#fff8e1";
    ep [label="extract_primary\nretries=0"]; ea [label="extract_api\nretries=3 + backoff"];
    rawp [label="raw/primary/<batch>\nparquet + manifest", shape=cylinder, fillcolor="#e8f5e9"];
    rawa [label="raw/api/<batch>\nparquet + manifest", shape=cylinder, fillcolor="#e8f5e9"];
    g1 [label="GATE 1\nvalidate_primary_raw\n(GX + politica)", fillcolor="#ffe0e0"]; g2 [label="GATE 2\nvalidate_api_raw\n(GX + politica)", fillcolor="#ffe0e0"];
    tr [label="transform_and_clean_\nand_integrate\n(llave municipio+anio)"];
    prep [label="prepared/<batch>\nparquet + manifest", shape=cylinder, fillcolor="#e8f5e9"];
    g3 [label="GATE 3\nvalidate_prepared\n(GX + politica)", fillcolor="#ffe0e0"];
    ld [label="load_dimensional_dw\nTX atomica, retries=2"]; }
  subgraph cluster_dw { label="PostgreSQL"; style=filled; fillcolor="#e3f2fd";
    dw [label="Data Warehouse dimensional\n(dim_* , fact_*)", shape=cylinder, fillcolor="#bbdefb"];
    ops [label="ops.* (run_log, validation_result,\nload_audit, reconciliation)", shape=cylinder, fillcolor="#bbdefb"]; }
  bi [label="SQL queries -> KPIs -> Dashboard\n(R1-R7)", fillcolor="#e1bee7"];
  rnt -> ep; api -> ea; ep -> rawp; ea -> rawa; rawp -> g1; rawa -> g2;
  g1 -> tr [label="pasa politica"]; g2 -> tr [label="pasa politica"]; tr -> prep -> g3; g3 -> ld [label="Critical => STOP"]; ld -> dw; dw -> bi;
  g1 -> ops [style=dashed]; g2 -> ops [style=dashed]; g3 -> ops [style=dashed]; ld -> ops [style=dashed];
}
